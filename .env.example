ANTHROPIC_API_KEY=sk-ant-...

# --- Optional (defaults shown) ---

# Language selected when the page first opens: fr es it pt de nl sv da no pl cs ru el
# DEFAULT_LANGUAGE=fr

# Deck per language. {language} is the English name (French, German...), {code} is fr, de...
# ANKI_DECK={language}::Novel
# Override one language's deck:
# ANKI_DECK_DE=Deutsch::Vokabeln

# Note type the cards use (created automatically if missing)
# ANKI_NOTE_TYPE=Novel Gloss

# Other note types of yours to check before adding, so a word you already have isn't added twice.
# Comma-separated, per language:
# ANKI_DUP_NOTE_TYPES_FR=My French Vocab

# AnkiConnect address, and its apiKey if you set one in the add-on's config
# ANKI_URL=http://127.0.0.1:8765
# ANKI_API_KEY=

# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low
# PORT=8787
